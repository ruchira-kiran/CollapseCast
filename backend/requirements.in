# Direct runtime dependencies, pinned exactly (versions checked against PyPI on 2026-09-18).
# requirements.txt is compiled from this file and pins the whole tree, including transitive
# dependencies. To change a version, edit it here and re-run (from backend/):
#
#   uv pip compile requirements.in -o requirements.txt --python-version 3.12 --python-platform linux
#
