scikit-learn==1.9.1
# CPU-only build of XGBoost from the XGBoost project (same `import xgboost`). Plain `xgboost` pulls in
# nvidia-nccl-cu13 (~290 MB of GPU libraries) on Linux, which we never use and which bloats the image.
xgboost-cpu==3.4.1
